/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgebutler",
  "account_id": "f38ba4aa6ff2c771304ff399994c6d92",
  "main": "src/server.ts",
  "compatibility_date": "2026-03-02",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/agents/*",
      "/api/*",
      "/install.sh",
      "/oauth/*",
      "/telegram"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "EdgeButler",
        "name": "EdgeButler"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["EdgeButler"],
      "tag": "v1"
    }
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
